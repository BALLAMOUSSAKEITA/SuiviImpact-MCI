# Variables Railway — Backend (service backend/)
# Copier/coller dans Railway → Service Backend → Variables

# Injecté automatiquement si PostgreSQL est lié au service :
# DATABASE_URL=postgresql://...

SECRET_KEY=GENERER-avec-openssl-rand-hex-32
DEBUG=false

# URL publique du frontend Railway (après déploiement frontend)
# Plusieurs origines séparées par des virgules
CORS_ORIGINS=https://VOTRE-FRONTEND.up.railway.app

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGER-MOT-DE-PASSE-FORT
ADMIN_PRENOM=Administrateur

UPLOAD_DIR=uploads
DEFAULT_ANNEE=2025

# Optionnel — si service Redis Railway ajouté et lié :
# REDIS_URL=redis://...

# Optionnel — emails de rappel
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@mipme.gov.gn
