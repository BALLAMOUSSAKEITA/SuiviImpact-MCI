# PostgreSQL
DB_PASSWORD=suivi_dev_password
DATABASE_URL=postgresql+asyncpg://suivi:suivi_dev_password@postgres:5432/suiviimpact

# Backend
APP_NAME=SuiviImpact API
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_PRENOM=Administrateur

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Upload & fichiers
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# SMTP (rappels email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@suiviimpact.gov.gn
SMTP_BSD_CC=bsd.mcipme@gmail.com

# E-mails sur Railway : SMTP sortant bloqué → utiliser Resend (HTTPS)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx
# SMTP_FROM=SuiviImpact <onboarding@resend.dev>

# Année planification par défaut
DEFAULT_ANNEE=2026
