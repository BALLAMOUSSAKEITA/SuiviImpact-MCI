# Variables Railway — Frontend (service frontend/)
# Copier/coller dans Railway → Service Frontend → Variables

# URL publique du backend Railway (Settings → Networking → Public URL)
# IMPORTANT : définir AVANT le build, puis redéployer si vous changez l'URL
NEXT_PUBLIC_API_URL=https://VOTRE-BACKEND.up.railway.app

